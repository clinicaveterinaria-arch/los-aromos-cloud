{% extends 'base.html' %}{% block content %}<h1>Migración MyVete</h1><div class="card"><p>Este módulo administrativo recibirá exportaciones de MyVete para importar propietarios, pacientes, historias clínicas y adjuntos por etapas.</p><form method="post" action="/migration/upload" enctype="multipart/form-data"><label>Subir archivo Excel/CSV/PDF</label><input type="file" name="file" required><button class="btn">Subir para vista previa</button></form></div><div class="card"><h2>Registro de migraciones</h2><table><tr><th>Fecha</th><th>Archivo</th><th>Estado</th><th>Detalle</th></tr>{% for l in logs %}<tr><td>{{ l.created_at.strftime('%d/%m/%Y %H:%M') }}</td><td>{{ l.filename }}</td><td>{{ l.status }}</td><td>{{ l.details }}</td></tr>{% endfor %}</table></div>{% endblock %}
