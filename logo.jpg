{% extends 'base.html' %}{% block content %}
<h1>{{ patient.name }}</h1>
<div class="panel patient-head"><div><b>Propietario:</b> {{ patient.owner.name }}<br><b>Tel:</b> {{ patient.owner.phone }} {{ patient.owner.whatsapp }}<br><b>Especie:</b> {{ patient.species }} | <b>Raza:</b> {{ patient.breed }} | <b>Sexo:</b> {{ patient.sex }} | <b>Peso:</b> {{ patient.weight or '' }} kg</div>{% if patient.alerts %}<div class="alert"><b>Alertas:</b> {{ patient.alerts }}</div>{% endif %}</div>
<div class="panel"><h2>Nuevo evento clínico</h2><form method="post" action="/patients/{{ patient.id }}/events" class="form-grid">
<select name="event_type">{% for t in event_types %}<option>{{ t }}</option>{% endfor %}</select><input name="title" placeholder="Título / motivo"><textarea name="description" placeholder="Descripción / anamnesis / hallazgos"></textarea><textarea name="diagnosis" placeholder="Diagnóstico / conclusión"></textarea><textarea name="treatment" placeholder="Tratamiento / indicaciones"></textarea><label>Recordatorio opcional<input type="date" name="reminder_date"></label><button>Guardar evento</button></form></div>
<div class="panel"><h2>Línea de tiempo</h2>{% for e in events %}<div class="timeline-item"><b>{{ e.event_type }}</b> <small>{{ e.event_date.strftime('%d/%m/%Y %H:%M') }}</small><h3>{{ e.title }}</h3>{% if e.description %}<p>{{ e.description }}</p>{% endif %}{% if e.diagnosis %}<p><b>Diagnóstico/conclusión:</b> {{ e.diagnosis }}</p>{% endif %}{% if e.treatment %}<p><b>Tratamiento:</b> {{ e.treatment }}</p>{% endif %}{% if e.reminder_date %}<p class="reminder">Recordatorio: {{ e.reminder_date.strftime('%d/%m/%Y') }}</p>{% endif %}</div>{% else %}<p>Sin eventos clínicos aún.</p>{% endfor %}</div>
{% endblock %}
